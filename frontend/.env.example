VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Auth Mode: LENIENT (default) or STRICT
# LENIENT: Allows temp emails, no strict email verification blocking (development)
# STRICT: Enforces email verification, corporate restrictions (production)
VITE_AUTH_MODE=LENIENT
